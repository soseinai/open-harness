/target
# `oharness-py` builds outside the workspace, so it has its own
# sibling `target/` that the root-level `/target` rule doesn't cover.
crates/oharness-py/target
# Local virtualenv used by `just python-examples` and contributors
# iterating on the Python bindings. Not part of the repo.
crates/oharness-py/.venv
Cargo.lock
*.swp
.DS_Store
.lattice/
